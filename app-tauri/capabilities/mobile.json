{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Android : choisir un fichier à importer, la bulle flottante (src/bubble.rs) et le déverrouillage biométrique (src/biometric.rs) et le remplissage automatique (src/autofill.rs).",
  "platforms": [
    "android"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "bubble:allow-available",
    "bubble:allow-allowed",
    "bubble:allow-ask",
    "bubble:allow-show",
    "bubble:allow-hide",
    "bubble:allow-locked",
    "bubble:allow-auto",
    "autofill:allow-status",
    "autofill:allow-request",
    "autofill:allow-disable",
    "autofill:allow-update",
    "autofill:allow-clear",
    "autofill:allow-forget",
    "autofill:allow-password",
    "biometric:allow-status",
    "biometric:allow-state",
    "biometric:allow-enable",
    "biometric:allow-unlock",
    "biometric:allow-touch",
    "biometric:allow-disable",
    "opener:default"
  ]
}
