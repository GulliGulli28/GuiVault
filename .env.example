# Copier en `.env` et remplir. Ce fichier est lu par docker compose.

# Mot de passe de la base PostgreSQL (interne au réseau compose).
POSTGRES_PASSWORD=

# Secret serveur, au moins 32 caractères : `openssl rand -base64 48`.
# Ne chiffre aucun secret utilisateur (le serveur n'en voit jamais) ; sert à
# rendre les réponses de prelogin indiscernables pour les comptes inexistants.
GUIVAULT_SECRET=

# open | invite_only | closed
GUIVAULT_REGISTRATION=invite_only

# Adresses toujours autorisées à s'inscrire, séparées par des virgules —
# c'est ainsi qu'on crée le premier compte en mode invite_only.
# Accepte un suffixe de domaine : `@mon-entreprise.fr`.
GUIVAULT_ALLOWED_EMAILS=admin@example.com

# Port local d'écoute (par défaut lié à 127.0.0.1 uniquement).
GUIVAULT_PORT=127.0.0.1:8080

# Qui a le droit de poser X-Forwarded-For — c'est ce qui décide du rate-limit
# par IP des routes d'authentification. Mettez l'adresse ou le réseau de votre
# reverse proxy : l'en-tête n'est alors lu que s'il vient bien de lui.
#   GUIVAULT_TRUST_PROXY=172.18.0.0/16
#   GUIVAULT_TRUST_PROXY=192.168.1.10, 10.0.0.2
# `true` le croit sans vérifier (seulement si le port est injoignable
# autrement), `false` l'ignore.
GUIVAULT_TRUST_PROXY=false

# Pour le profil `tls` (Caddy avec Let's Encrypt) :
# GUIVAULT_DOMAIN=vault.example.com

# Rate-limit des routes d'authentification, par IP (jetons/s et rafale).
# À relever seulement pour une machine de dev qui lance des tests.
# GUIVAULT_AUTH_RATE_PER_SECOND=2
# GUIVAULT_AUTH_RATE_BURST=10

# Historique et corbeille : versions précédentes gardées par élément
# (chiffrées, 0 = ni historique ni corbeille) et jours dans la corbeille.
# GUIVAULT_ITEM_HISTORY=20
# GUIVAULT_TRASH_DAYS=30

# Liens de partage : durée de vie maximale en jours (0 = désactivés) ; relais
# des recherches du rapport de santé (false = aucune requête sortante).
# GUIVAULT_SEND_MAX_DAYS=30
# GUIVAULT_HEALTH_LOOKUPS=true

# Pièces jointes : taille maximale d'un fichier en Mio (0 = désactivées). Elles
# sont gardées dans la base et comptent dans le quota et les sauvegardes.
# GUIVAULT_MAX_ATTACHMENT_MB=100

# Quota de stockage par compte, en Mio (0 = aucun) ; un administrateur peut le
# changer compte par compte.
# GUIVAULT_QUOTA_MB=0

# Restreindre le serveur à des plages d'adresses (vide = toutes) — l'API,
# l'interface et les liens de partage ; la sonde /api/v1/health reste
# joignable. La seconde ne restreint que l'administration (/admin).
# Derrière un proxy, régler GUIVAULT_TRUST_PROXY pour que l'adresse vue soit
# celle du client.
#   GUIVAULT_ALLOWED_IPS=192.168.1.0/24, 10.8.0.0/16
#   GUIVAULT_ADMIN_ALLOWED_IPS=192.168.1.0/24

# Sauvegardes (docker-compose : quotidiennes dans le volume `backups`, 7
# gardées, chacune restaurée dans une base d'essai et comparée). Vide pour les
# couper ; `guivault backup create|verify|restore` à la main (voir README).
# GUIVAULT_BACKUP_DIR=/backups
# GUIVAULT_BACKUP_INTERVAL_HOURS=24
# GUIVAULT_BACKUP_KEEP=7
# GUIVAULT_BACKUP_VERIFY_DATABASE_URL=postgres://guivault:…@db:5432/guivault_restore_check

# E-mails, facultatifs : invitations, alerte de connexion depuis une adresse
# inconnue, mot de passe et second facteur changés, étapes de l'accès
# d'urgence. Rien n'en dépend : sans eux, ou SMTP en panne, tout marche pareil.
#   GUIVAULT_SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.fr:465
#   GUIVAULT_SMTP_URL=smtp://utilisateur:motdepasse@smtp.exemple.fr:587?tls=required
# GUIVAULT_SMTP_FROM=GuiVault <coffre@exemple.fr>
# GUIVAULT_PUBLIC_URL=https://vault.exemple.fr
