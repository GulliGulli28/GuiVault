{
  "name": "guivault-web",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "dev:app": "vite -c vite.app.config.ts",
    "build:app": "tsc -b && vite build -c vite.app.config.ts",
    "test:app": "node app/e2e/run.mjs",
    "build:ext": "vite build -c vite.extension.config.ts && vite build -c vite.content.config.ts && vite build -c vite.shim.config.ts",
    "test:ext": "npm run build:ext && playwright test -c extension/e2e"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "jsqr": "^1.4.0",
    "kdbxweb": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.7",
    "webdriverio": "^9.32.0"
  },
  "overrides": {
    "kdbxweb": {
      "@xmldom/xmldom": "0.8.15"
    }
  }
}
